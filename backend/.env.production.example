# 欲阅 · 生产环境配置（由 scripts/install.sh 自动生成 backend/.env，也可手动复制）

ENVIRONMENT=production
SEED_ON_STARTUP=false

SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

DATABASE_URL=sqlite:////var/lib/yuyue/yuyue.db
UPLOAD_DIR=/var/lib/yuyue/uploads

ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_UPLOAD_MB=2

# 单端口对外服务（默认 9080，避开常见的 80 / 8000）
HOST=0.0.0.0
PORT=9080
FRONTEND_DIST=/opt/yuyue/frontend/dist

CORS_ORIGINS=["http://127.0.0.1:9080"]
